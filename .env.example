# Resend (https://resend.com) — sends the full form summary to merovidigital@gmail.com
# whenever someone submits /solicitar-meu-site. Required.
RESEND_API_KEY=

# Optional: sender shown on the e-mail. Must be either Resend's shared test
# sender (onboarding@resend.dev, no domain verification needed, works right
# away) or an address on a domain you've verified in Resend. Defaults to
# "Merovi <contato@merovi.com.br>" if unset. Do not wrap the value in quotes
# here — Next.js loads env values literally, quotes included.
REQUEST_FORM_FROM_EMAIL=Merovi <contato@merovi.com.br>
